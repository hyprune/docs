---
// Same camera, successive Lumen Reach releases. Radio buttons switch the frame
// without JavaScript; without CSS every frame is shown in order.
interface Props { id: string; title: string; frames: { version: string; name: string; alt: string; note?: string }[]; single?: boolean; }
// single: one <name>-1280.webp per frame instead of the 800/1600 pair.
const { id, title, frames, single = false } = Astro.props;
const last = frames.length - 1;
// One show/highlight rule per frame, scoped to this stepper (any number of frames).
const css = frames.map((_, i) => `#evo-${id} .evo-r${i}:checked ~ .evo-frames .evo-f${i}{visibility:visible;opacity:1}` +
  `#evo-${id} .evo-r${i}:checked ~ figcaption .evo-l${i}{background:var(--sl-color-accent);color:var(--sl-color-text-invert);font-weight:650}`).join('');
---
<style is:inline set:html={css}></style>
<figure class="evolution not-content" id={`evo-${id}`} aria-label={title}>
  {frames.map((f, i) => <input type="radio" name={`evo-${id}`} id={`evo-${id}-${i}`} checked={i === last} class={`evo-radio evo-r${i}`} />)}
  <div class="evo-frames">
    {frames.map((f, i) => (
      <div class={`evo-frame evo-f${i}`}>
        {single
          ? <img src={`/media/lumen-reach/${f.name}-1280.webp`} width="1280" height="720" alt={f.alt} loading="lazy" decoding="async" />
          : <img src={`/media/lumen-reach/${f.name}-1600.webp`} srcset={`/media/lumen-reach/${f.name}-800.webp 800w, /media/lumen-reach/${f.name}-1600.webp 1600w`}
              sizes="(min-width: 72rem) 50rem, 100vw" width="1600" height="900" alt={f.alt} loading="lazy" decoding="async" />}
        {f.note && <p class="evo-note"><strong>{f.version}</strong> · {f.note}</p>}
      </div>
    ))}
  </div>
  <figcaption>
    <span class="evo-title">{title}</span>
    <span class="evo-steps" role="group" aria-label="Release">
      {frames.map((f, i) => <label for={`evo-${id}-${i}`} class={`evo-l${i}`}>{f.version}</label>)}
    </span>
  </figcaption>
</figure>
